# Mahin local development placeholders.
# Copy to `.env` (gitignored). Never put production secrets in this file or the repository.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mahin
POSTGRES_USER=mahin
POSTGRES_PASSWORD=changeme

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# S3-compatible object storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=miniochangeme
S3_BUCKET=mahin-media
S3_FORCE_PATH_STYLE=true

# Public media base used to *construct* URLs at runtime from storage keys.
# Do not hard-code a production CDN host in application feature code.
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/mahin-media

# Backend
MAHIN_ENV=local
SERVER_PORT=8080
MAHIN_AUTH_JWT_SECRET=replace-with-long-random-secret

# Admin (Vite)
VITE_API_BASE_URL=http://localhost:8080

# Android release API (Gradle — see android/gradle.properties, ADR 0018)
# mahin.api.baseUrl.release=https://api.mahin.app/
